# Keitaro emulator: base URL without /admin_api/v1
KEITARO_URL=https://keitaro-for-tests.etolegko.com
# Profile -> "API ключ" in the Keitaro admin. Never commit the real key.
KEITARO_API_KEY=

# Defaults preselected in the "New campaign" form (ids from the emulator catalog)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_SOURCE_ID=836

CAMPAIGN_PREFIX=test_tadjibayev_

# PostgreSQL in docker-compose; for local dev you can use sqlite:
# DATABASE_URL=sqlite+aiosqlite:///./keitaro_wrapper.db
DATABASE_URL=postgresql+asyncpg://wrapper:wrapper@db:5432/wrapper
